station255.com, www.station255.com {
    root * /root/station255/dist

    # SvelteKit adapter-static prerenders each route to "<route>.html"
    # (e.g. /palette-extractor -> palette-extractor.html). Try the literal
    # path, then the .html file (correct per-page SEO meta), then a directory
    # index, and only fall back to / as a last resort.
    try_files {path} {path}.html {path}/index.html /index.html

    file_server
}
