station255.com, www.station255.com {
    root * /root/station255/dist

    # Proxy analytics collection and coin counter to local analytics server (port 4000)
    handle /collect {
        reverse_proxy localhost:4000
    }

    handle /coin {
        reverse_proxy localhost:4000
    }

    # SvelteKit adapter-static: try literal path, then .html, then index, fallback to /
    handle {
        try_files {path} {path}.html {path}/index.html /index.html
        file_server
    }
}
